{
    "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!**/*.md",
            "!**/*.mdx",
            "!reconstructions/**/*.svg",
            "!viewer/index.html",
            "!viewer/src",
            "!viewer/tests"
        ]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4
    }
}
